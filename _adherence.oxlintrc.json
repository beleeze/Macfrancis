{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/atoms/AddAssetButton/**",
              "components/atoms/AssetSquareCard/**",
              "components/atoms/BackButton/**",
              "components/atoms/Button/**",
              "components/atoms/Change/**",
              "components/atoms/ChartTimeButton/**",
              "components/atoms/ConnectionTag/**",
              "components/atoms/Input/**",
              "components/atoms/LabelChange/**",
              "components/atoms/Tag/**",
              "components/atoms/TransactionTag/**",
              "components/general/MenuOption/**",
              "components/general/MenuTrigger/**",
              "components/general/StepAuth/**",
              "components/general/StepDone/**",
              "components/general/StepError/**",
              "components/general/StepFileImport/**",
              "components/general/StepKeyCredentials/**",
              "components/general/StepStart/**",
              "components/markets/CryptoContent/**",
              "components/markets/StockContent/**",
              "components/molecules/AssetCardInfo/**",
              "components/molecules/ChartAssetInfo/**",
              "components/molecules/ChartCard/**",
              "components/molecules/ChartCardInfo/**",
              "components/molecules/ChartInfo/**",
              "components/molecules/ConnectCard/**",
              "components/molecules/ConnectionCard/**",
              "components/molecules/ConnectionSettingCard/**",
              "components/molecules/DashboardAssetCard/**",
              "components/molecules/DataPoint/**",
              "components/molecules/DropdownMenu/**",
              "components/molecules/FiatCard/**",
              "components/molecules/Header/**",
              "components/molecules/HeaderAssetType/**",
              "components/molecules/IsaAllowanceCard/**",
              "components/molecules/Pagination/**",
              "components/molecules/PriceRange/**",
              "components/molecules/SearchBar/**",
              "components/molecules/SearchToggle/**",
              "components/molecules/SelectionGroup/**",
              "components/molecules/SettingRow/**",
              "components/molecules/TextContainerButton/**",
              "components/molecules/TransactionCard/**",
              "components/organisms/AssetAllocationCard/**",
              "components/organisms/BottomModal/**",
              "components/organisms/ChartAsset/**",
              "components/organisms/ChartInsights/**",
              "components/organisms/CompanyInformation/**",
              "components/organisms/ConnectionIssueModal/**",
              "components/organisms/DashboardList/**",
              "components/organisms/HorizontalNav/**",
              "components/organisms/LoadingOverlay/**",
              "components/organisms/MarketData/**",
              "components/organisms/MarketsSection/**",
              "components/organisms/NetChartCard/**",
              "components/organisms/Paywall/**",
              "components/organisms/PlatformSteps/**",
              "components/organisms/PortfolioChart/**",
              "components/organisms/ProfileHeader/**",
              "components/organisms/VerificationCode/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddAssetButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|key|ref|className|style|children)$/]",
        "message": "<AddAssetButton> doesn't accept that prop. Declared props: to."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetCardInfo'] > JSXAttribute > JSXIdentifier[name!=/^(?:asset|setTotalAmount|key|ref|className|style|children)$/]",
        "message": "<AssetCardInfo> doesn't accept that prop. Declared props: asset, setTotalAmount."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetSquareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|icon|key|ref|className|style|children)$/]",
        "message": "<AssetSquareCard> doesn't accept that prop. Declared props: type, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|onPress|direction|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: to, onPress, direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<BackButton> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<BottomModal> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|outline|onPress|color|isDisabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, outline, onPress, color, isDisabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Change'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|percentage|key|ref|className|style|children)$/]",
        "message": "<Change> doesn't accept that prop. Declared props: amount, percentage."
